# GraphQL schema example
#
# https://gqlgen.com/getting-started/

type Entity {
  id: String!
  type: String!
  name: String!
}

type Relationship {
  source: Entity!
  target: Entity!
  type: String!
}

type SearchResult {
  nodes: [Entity!]!
  edges: [Relationship!]!
}

type Query {
  searchGraph(keyword: String!): SearchResult!
}